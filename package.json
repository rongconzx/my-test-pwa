  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4300 --ssl=true",
    "build": "ng build",
    "deploy": "ng build --configuration production --base-href '/ng2-barcode-validator/' && angular-cli-ghpages",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "dev": "docker-compose up ngx-barcode-scanner",
    "prod": "docker-compose up ngx-barcode-scanner-prod",
    "prod:ci": "docker-compose up -d ngx-barcode-scanner-prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/material": "22.2.7",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "quagga": "^0.12.1",
    "rxjs": "^7.8.2",
    "tesseract.js": "^1.0.14",
    "tesseract.ts": "^1.1.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@types/jasmine": "^5.1.10",
    "@types/node": "^22.19.0",
    "angular-cli-ghpages": "^3.1.2",
    "jasmine-core": "^5.9.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "postcss": "^8.5.6",
    "typescript": "6.0.3"
  }
}
